generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:dev.sqlite"
}

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

model GoogleUser {
  id String @id @default(cuid())
  googleId String
  name String
  email String @unique
  profileImage String?
  shopifyCustomerId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AuthorizationCode {
  id        String   @id @default(cuid())
  code      String   @unique
  email     String
  name      String
  userId    String
  nonce     String
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model linkedUser {
  id String @id @default(cuid())
  linkedId String
  name String
  email String @unique
  profileImage String?
  shopifyCustomerId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model twitterUser {
  id                 String   @id @default(cuid())
  twitterId          String
  name               String
  email              String   @unique
  profileImage       String?
  shopifyCustomerId  String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model facebookUser {
  id                 String   @id @default(cuid())
  facebookId         String
  name               String
  email              String   @unique
  profileImage       String?
  shopifyCustomerId  String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model amazonUser {
  id                String   @id @default(cuid())
  amazonId          String
  name              String
  email             String   @unique
  shopifyCustomerId String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model EmailOtp {
  id          String   @id @default(cuid())
  email       String
  code        String
  state       String
  redirectUri String
  nonce       String
  attempts    Int      @default(0)
  consumed    Boolean  @default(false)
  expiresAt   DateTime
  createdAt   DateTime @default(now())
}

model ShopSettings {
  id              String   @id @default(cuid())
  shop            String   @unique
  googleEnabled   Boolean  @default(true)
  twitterEnabled  Boolean  @default(true)
  facebookEnabled Boolean  @default(true)
  linkedinEnabled Boolean  @default(true)
  amazonEnabled   Boolean  @default(true)
  appEnabled      Boolean  @default(true)
  serialKey       String?  @unique
  registered      Boolean  @default(false)
  username        String?
  accountEmail    String?
  googleLogo      String?
  twitterLogo     String?
  facebookLogo    String?
  linkedinLogo    String?
  amazonLogo      String?

  googleClientId       String?
  googleClientSecret   String?
  googleCallbackUrl    String?
  googleSortOrder      Int      @default(1)

  facebookClientId     String?
  facebookClientSecret String?
  facebookCallbackUrl  String?
  facebookSortOrder    Int      @default(3)

  twitterClientId      String?
  twitterClientSecret  String?
  twitterCallbackUrl   String?
  twitterSortOrder     Int      @default(4)

  amazonClientId       String?
  amazonClientSecret   String?
  amazonCallbackUrl    String?
  amazonSortOrder      Int      @default(5)

  linkedinClientId     String?
  linkedinClientSecret String?
  linkedinCallbackUrl  String?
  linkedinSortOrder    Int      @default(2)

  oidcClientId     String?
  oidcClientSecret String?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}